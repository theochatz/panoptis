"""
API integration tests using FastAPI TestClient with an in-memory SQLite DB.

These tests verify that:
  - HTTP status codes are correct for valid and invalid inputs
  - UUID path params return 422 (not 500) when malformed
  - Business rules (404 for missing records, 400 for bad requests) work
  - Response shapes match the declared response_model

FastAPI's TestClient runs synchronously against an ASGI app configured
with a test SQLite database — no real Postgres or Celery needed.
"""

from __future__ import annotations

import os
import pytest
import pytest_asyncio

# Must be set before importing app modules
os.environ["DATABASE_URL"]        = "sqlite+aiosqlite:///./test_api.db"
os.environ["CELERY_BROKER_URL"]   = "memory://"
os.environ["CELERY_RESULT_BACKEND"] = "cache+memory://"

from fastapi.testclient import TestClient
from sqlalchemy.ext.asyncio import AsyncSession, create_async_engine
from sqlalchemy.orm import sessionmaker

from app.core.database import Base, get_db, Policy, Subscription
from app.main import app


# ── Test DB setup ─────────────────────────────────────────────────────────────

TEST_DB_URL = "sqlite+aiosqlite:///./test_api.db"
test_engine = create_async_engine(TEST_DB_URL, echo=False)
TestSessionLocal = sessionmaker(test_engine, class_=AsyncSession, expire_on_commit=False)


async def override_get_db():
    async with TestSessionLocal() as session:
        yield session


@pytest.fixture(scope="module", autouse=True)
def setup_test_db():
    """Create tables once for the module, drop after."""
    import asyncio

    async def _setup():
        async with test_engine.begin() as conn:
            await conn.run_sync(Base.metadata.create_all)

    async def _teardown():
        async with test_engine.begin() as conn:
            await conn.run_sync(Base.metadata.drop_all)
        import aiofiles.os as aio_os
        if os.path.exists("test_api.db"):
            os.remove("test_api.db")

    asyncio.get_event_loop().run_until_complete(_setup())
    app.dependency_overrides[get_db] = override_get_db
    yield
    asyncio.get_event_loop().run_until_complete(_teardown())
    app.dependency_overrides.clear()


@pytest.fixture
def client():
    # Disable lifespan (avoids needing real Postgres LISTEN)
    with TestClient(app, raise_server_exceptions=True) as c:
        yield c


