# ── Policies ──────────────────────────────────────────────────────────────────

class TestPoliciesAPI:
    def test_list_policies_empty(self, client):
        r = client.get("/api/policies")
        assert r.status_code == 200
        assert r.json() == []

    def test_create_policy_returns_201(self, client):
        payload = {
            "name": "test-policy",
            "resource_type": "azure.vm",
            "category": "idle",
            "severity": "medium",
            "yaml_content": "policies:\n  - name: test\n",
        }
        r = client.post("/api/policies", json=payload)
        assert r.status_code == 201
        data = r.json()
        assert data["name"] == "test-policy"
        assert "id" in data

    def test_get_policy_bad_uuid_returns_422(self, client):
        r = client.get("/api/policies/not-a-uuid")
        assert r.status_code == 422

    def test_get_policy_missing_returns_404(self, client):
        r = client.get("/api/policies/9a2f8c1d-0001-0001-0001-000000000001")
        assert r.status_code == 404

    def test_delete_policy_bad_uuid_returns_422(self, client):
        r = client.delete("/api/policies/bad-uuid")
        assert r.status_code == 422

    def test_toggle_policy_bad_uuid_returns_422(self, client):
        r = client.patch("/api/policies/bad-uuid/toggle")
        assert r.status_code == 422

    def test_create_and_toggle_policy(self, client):
        payload = {
            "name": "toggle-test",
            "resource_type": "azure.disk",
            "category": "orphaned",
            "severity": "high",
            "yaml_content": "policies:\n  - name: t\n",
            "enabled": True,
        }
        create_r = client.post("/api/policies", json=payload)
        assert create_r.status_code == 201
        policy_id = create_r.json()["id"]

        toggle_r = client.patch(f"/api/policies/{policy_id}/toggle")
        assert toggle_r.status_code == 200
        assert toggle_r.json()["enabled"] is False

        toggle_r2 = client.patch(f"/api/policies/{policy_id}/toggle")
        assert toggle_r2.json()["enabled"] is True


